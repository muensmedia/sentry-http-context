{
  "name": "muensmedia/sentry-http-context",
  "description": "Sentry breadcrumbs for Laravel's HTTP client: method, URL, masked headers, JSON request payload and decoded response body for every outgoing call. No call-site changes.",
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/http": "^11|^12",
    "spatie/laravel-package-tools": "^1.16",
    "sentry/sentry-laravel": "^4.27"
  },
  "require-dev": {
    "laravel/tinker": "^2.11",
    "orchestra/testbench": "^10.9",
    "pestphp/pest": "^3.8|^4.3",
    "pestphp/pest-plugin-arch": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.2|^4.0",
    "laravel/pint": "^1.27"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Muensmedia\\SentryHttpContext\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Iven Schlenther",
      "email": "i.schlenther@muensmedia.de"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Muensmedia\\SentryHttpContext\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Muensmedia\\SentryHttpContext\\SentryHttpContextServiceProvider"
      ]
    }
  },
  "keywords": [
    "laravel",
    "sentry",
    "sentry-laravel",
    "breadcrumbs",
    "http-client",
    "guzzle",
    "http-logging",
    "request-logging",
    "response-body",
    "json",
    "api-debugging",
    "error-tracking",
    "observability",
    "debugging",
    "php"
  ]
}
